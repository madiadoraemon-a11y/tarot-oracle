# ── Server-side secrets (Cloudflare Worker) ──
# Set via: npx wrangler secret put DEEPSEEK_API_KEY
# NEVER prefix with VITE_ and NEVER commit real keys

# DeepSeek API key (required)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Optional: custom API base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Client-side config (safe to expose) ──

# API endpoint for reading service (defaults to /api for same-origin proxy)
VITE_API_BASE=/api
